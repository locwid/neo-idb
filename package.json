{
  "name": "neo-idb",
  "version": "0.2.0",
  "description": "A modern wrapper around IndexedDB with a simple API and support for promises",
  "license": "MIT",
  "repository": "https://github.com/locwid/neo-idb",
  "author": {
    "name": "Maxim Gritsina",
    "url": "https://github.com/locwid"
  },
  "keywords": [
    "indexeddb",
    "idb",
    "database",
    "browser",
    "javascript",
    "typescript"
  ],
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/neo-idb.d.ts",
  "main": "./dist/neo-idb.umd.cjs",
  "module": "./dist/neo-idb.js",
  "exports": {
    ".": {
      "types": "./dist/neo-idb.d.ts",
      "import": "./dist/neo-idb.js",
      "require": "./dist/neo-idb.umd.cjs"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "build:watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "git config core.hooksPath .git-hooks || echo 'Not in a git repo'",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  }
}
